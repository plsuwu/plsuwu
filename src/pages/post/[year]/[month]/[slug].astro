---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getProcessedPosts } from "$scripts";
import PostContent from "$layouts/PostContent.astro";
import ImageModal from "$components/media/ImageModal.astro";

export const getStaticPaths = (async () => {
	const posts = await getProcessedPosts();
	return posts.map((post) => ({
		params: {
			year: post.params.year,
			month: post.params.month,
			slug: post.params.day,
		},
		props: post,
	}));
}) satisfies GetStaticPaths;

const post = Astro.props;
const { Content } = await render(post);
---

<PostContent {...post.data}>
	<Content />
</PostContent>
